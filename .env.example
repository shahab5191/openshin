# Copy to .env (gitignored) and fill in.

# Where the daemon's SQLite memory file lives.
OPENSHIN_DB_PATH=./openshin.db

# Provider selection: gemini | anthropic | openai | ollama | agenthost
OPENSHIN_PROVIDER=gemini

# https://aistudio.google.com/apikey (default provider)
GEMINI_API_KEY=
GEMINI_MODEL=

# Optional — embedding model (default text-embedding-004).
EMBEDDING_MODEL=

# Optional — Anthropic (Claude) provider.
ANTHROPIC_API_KEY=

# Optional — OpenAI provider.
OPENAI_API_KEY=

# Optional — Ollama (local, OpenAI-compatible).
OLLAMA_BASE_URL=http://localhost:11434
